---
import styles from "./header.module.css";
import { ToggleTheme } from "@/ui/darkmode/ToggleTheme.tsx";
import BurgerMenu from "./bm/BurgerMenu.tsx";
import { TOOLS } from "@/features/home/tools/tools.ts";

const path = Astro.url.pathname;
const allTools = TOOLS;
---

<header class={styles.header}>
	<nav class={styles.pill}>
		<a
			href="/"
			class={styles.logo}
			>qiip.me</a
		>

		<ul class={styles.links}>
			{
				allTools.map(({ href, toolName }) => (
					<li>
						<a
							href={href}
							class={`${styles.link} ${path === href ? styles.active : ""}`}
						>
							{toolName}
						</a>
					</li>
				))
			}
		</ul>

		<div class={styles.right}>
			<BurgerMenu
				tools={allTools}
				client:only="react"
			/>
			<ToggleTheme client:only="react" />
		</div>
	</nav>
</header>
