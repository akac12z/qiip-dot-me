---
import styles from "./header.module.css";
import ToolsMenu from "./tm/ToolsMenu.tsx";

import { ToggleTheme } from "@/ui/darkmode/ToggleTheme.tsx";
import { TOOLS } from "../home/tools/tools.ts";
import GitHub from "@/icons/GitHub.astro";

const path = Astro.url.pathname;
const allTools = TOOLS;
---

<header class={styles.header}>
	<nav class={styles.pill}>
		<a
			href="/"
			class={styles.logo}
			>qiip.me</a
		>

		<div class={styles.right}>
			<ToolsMenu
				tools={allTools}
				currentPath={path}
				client:only="react"
			/>
			<a
				href="https://github.com/akac12z/qiip-dot-me"
				target="_blank"
				rel="noopener noreferrer"
				class={styles.githubLink}
				aria-label="Ver proyecto qiip.me en GitHub"
			>
				<GitHub />
			</a>
			<ToggleTheme client:only="react" />
		</div>
	</nav>
</header>
