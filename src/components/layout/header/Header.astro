---
import { ToggleTheme } from "@/ui/darkmode/ToggleTheme";
import styles from "./second.module.css";

const path = Astro.url.pathname;

const links = [
	{ href: "/build-utms", label: "Build UTMs" },
	{ href: "/qr", label: "Create QRs" },
	{ href: "/word-count", label: "Word Count" },
	{ href: "/shorten-urls", label: "Shorten URLs" },
];
---

<header class={styles.header}>
	<nav class={styles.pill}>
		<a
			href="/"
			class={styles.logo}
			>qiip.me</a
		>

		<ul class={styles.links}>
			{
				links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class={`${styles.link} ${path === href ? styles.active : ""}`}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>

		<div class={styles.right}>
			<button
				class={styles.burger}
				id="burgerBtn"
				aria-label="Toggle menu"
				aria-expanded="false"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
			<ToggleTheme client:only="react" />
		</div>
	</nav>

	<div
		class={styles.mobileMenu}
		id="mobileMenu"
	>
		<div class={styles.mobileInner}>
			<ul class={styles.mobileLinks}>
				{
					links.map(({ href, label }) => {
						const isActive = path === href;
						return (
							<li>
								<a
									href={href}
									class={`${styles.mobileLink} ${isActive ? styles.active : ""}`}
								>
									{label}
									{isActive && <span class={styles.mobileDot} />}
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</div>
</header>

<script>
	document.addEventListener("astro:page-load", () => {
		const burger = document.getElementById("burgerBtn") as HTMLButtonElement;
		const menu = document.getElementById("mobileMenu") as HTMLElement;

		if (!burger || !menu) return;

		function close(): void {
			burger!.setAttribute("aria-expanded", "false");
			menu!.removeAttribute("data-open");
		}

		function toggle(): void {
			const isOpen = burger!.getAttribute("aria-expanded") === "true";
			burger!.setAttribute("aria-expanded", String(!isOpen));
			menu!.toggleAttribute("data-open", !isOpen);
		}

		function onClickOutside(e: MouseEvent): void {
			const target = e.target as Node;
			if (!burger!.contains(target) && !menu!.contains(target)) close();
		}

		burger.addEventListener("click", toggle);
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", close);
		});
		document.addEventListener("mousedown", onClickOutside);
	});
</script>
