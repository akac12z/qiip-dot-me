---
import styles from "./tools.module.css";
import { TOOLS } from "./tools.ts";
---

<section class={styles.grid}>
	{
		TOOLS.map((tool) => {
			const { toolName, desc, href, number, onAir, color } = tool;
			const index = number.toString().padStart(2, "0");

			return (
				<a
					href={href}
					class={styles.card}
					style={`--card-accent:${color};animation-delay:${number * 0.15}s`}
				>
					<span
						class={styles.cardNum}
						aria-hidden="true"
					>
						{index}
					</span>

					<section>
						<div class={styles.cardTop}>
							<p class={styles.name}>
								<span class={styles.dot} />
								{toolName}
								{!onAir && <span class={styles.soonTag}>Soon</span>}
							</p>
						</div>
						<p class={styles.desc}>{desc}</p>
					</section>
					<span class={styles.cta}>
						Open tool <span aria-hidden="true">→</span>
					</span>
				</a>
			);
		})
	}
</section>
