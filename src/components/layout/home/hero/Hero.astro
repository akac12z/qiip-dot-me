---
import styles from "./hero.module.css";
---

<section class={styles.hero}>
	<h1
		class={`au ${styles.h1} `}
		style="animation-delay:.05s"
	>
		<span class={`${styles.intro} au`}>keep your content</span>
		<span class={`${styles.claim} au`}>ready to share <em>anywhere.</em></span>
	</h1>
	<div
		class={`${styles.heroFoot} au`}
		style="animation-delay:.12s"
	>
		<p class={`${styles.sub} au`}>
			Share your content, track what works, and keep everything under <span
				class={styles.domain}>your own domain.</span
			>
		</p>
	</div>

	<p
		class={`${styles.meta} au`}
		style="animation-delay:.17s"
	>
		— Open-source tools for creators, marketers and builders.
	</p>
</section>
