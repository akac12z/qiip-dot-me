---
import styles from "./link.module.css";

interface Props {
	title: string;
	href: string;
	text: string;
	classes?: string;
}

const { title, href, text, classes } = Astro.props;
---

<a
	class={classes ? `${styles.anchor} ${classes}` : styles.anchor}
	target="_blank"
	rel="noopener noreferrer"
	title={title}
	href={href}
>
	{text}
</a>
