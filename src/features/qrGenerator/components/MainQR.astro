---
import QRGenerator from "@/qrGenerator/components/QRGenerator";
import styles from "./mainqr.module.css";
---

<section class={styles.wrap}>
	<span class={styles.eyebrow}>02 — QR Generator</span>
	<h2 class={styles.title}>Generate your QR code</h2>
	<p class={styles.desc}>
		Paste a URL or write it — your QR code is ready to scan or download in the
		format you prefer.
	</p>
	<QRGenerator client:only="react" />
</section>
