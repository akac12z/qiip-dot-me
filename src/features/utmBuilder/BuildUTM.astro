---
import styles from "./buildUtm.module.css";
import FormUTM from "./components/FormUTM.astro";
import PreviewURL from "./components/PreviewURL.astro";
---

<div class={styles.wrap}>
  <p class={styles.eyebrow}>01 — UTM Builder</p>
  <h2 class={styles.title}>Build your tracking URL</h2>
  <p class={styles.desc}>
    Fill in the fields and get your UTM URL ready to paste into your campaign.
  </p>
  <FormUTM />
  <PreviewURL />
</div>

<div id="utm-toast" class={styles.toast}></div>

<script>
  document.addEventListener("astro:page-load", () => {
    let _utmUrl = "";

    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

    function buildUTM() {
      const base = val("utm-url");
      const fields: Record<string, string> = {
        utm_source: val("utm-source"),
        utm_medium: val("utm-medium"),
        utm_campaign: val("utm-campaign"),
        utm_term: val("utm-term"),
        utm_content: val("utm-content"),
        utm_id: val("utm-id"),
      };

      const chips = document.getElementById("utm-chips");
      if (chips) {
        chips.innerHTML = Object.entries(fields)
          .map(([k, v]) => `<div class="param-chip${v ? " on" : ""}">${k}</div>`)
          .join("");
      }

      const result = document.getElementById("utm-result");
      if (!base || !fields.utm_source || !fields.utm_medium || !fields.utm_campaign) {
        delete result?.dataset.show;
        return;
      }

      try {
        const url = new URL(base);
        Object.entries(fields).forEach(([k, v]) => {
          if (v) url.searchParams.set(k, v);
        });
        _utmUrl = url.toString();
        const output = document.getElementById("utm-output");
        if (output) output.textContent = _utmUrl;
        if (result) result.dataset.show = "true";
      } catch {
        delete result?.dataset.show;
      }
    }

    function copyUTM() {
      if (!_utmUrl) return;
      navigator.clipboard.writeText(_utmUrl);
      showToast("✓ URL copiada");
    }

    function showToast(msg: string) {
      const toast = document.getElementById("utm-toast");
      if (!toast) return;
      toast.textContent = msg;
      toast.dataset.show = "true";
      setTimeout(() => delete toast.dataset.show, 2200);
    }

    const inputIds = [
      "utm-url",
      "utm-source",
      "utm-medium",
      "utm-campaign",
      "utm-term",
      "utm-content",
      "utm-id",
    ];
    inputIds.forEach((id) => document.getElementById(id)?.addEventListener("input", buildUTM));

    document.getElementById("utm-copy-head-btn")?.addEventListener("click", copyUTM);
    document.getElementById("utm-copy-url-btn")?.addEventListener("click", copyUTM);
    document.getElementById("utm-qr-btn")?.addEventListener("click", (e) => {
      if (_utmUrl) {
        e.preventDefault();
        sessionStorage.setItem("qr-prefill", _utmUrl);
        window.location.href = "/qr";
      }
    });
  });
</script>
