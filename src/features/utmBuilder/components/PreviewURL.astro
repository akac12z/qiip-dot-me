---
import styles from "./previewUrl.module.css";
---

<section
	id="utm-chips"
	class={styles.chipsRow}
>
	<div data-chip="off" data-key="utm_source">utm_source</div>
	<div data-chip="off" data-key="utm_medium">utm_medium</div>
	<div data-chip="off" data-key="utm_campaign">utm_campaign</div>
	<div data-chip="off" data-key="utm_term">utm_term</div>
	<div data-chip="off" data-key="utm_content">utm_content</div>
	<div data-chip="off" data-key="utm_id">utm_id</div>
</section>

<section
	id="utm-result"
	class={styles.result}
>
	<div class={styles.resultHead}>
		<span
			id="utm-result-label"
			class={styles.resultLabel}
			>Generated URL</span
		>
	</div>
	<div class={styles.resultBody}>
		<div
			id="utm-output"
			class={styles.resultUrl}
		>
		</div>
		<div class={styles.resultActions}>
			<button
				id="utm-copy-url-btn"
				class={styles.btnPrimary}
				disabled
				>Copy URL</button
			>
			<a
				href="/qr"
				id="utm-qr-btn"
				class={styles.btnSecondary}
				>Generate QR →</a
			>
		</div>
	</div>
</section>
