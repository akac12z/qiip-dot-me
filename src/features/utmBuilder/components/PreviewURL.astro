---
import styles from "./previewUrl.module.css";
---

<section
	id="utm-chips"
	class={styles.chipsRow}
>
</section>

<section
	id="utm-result"
	class={styles.result}
>
	<div class={styles.resultHead}>
		<span class={styles.resultLabel}>URL ready</span>
	</div>
	<div class={styles.resultBody}>
		<div
			id="utm-output"
			class={styles.resultUrl}
		>
		</div>
		<div class={styles.resultActions}>
			<button
				id="utm-copy-url-btn"
				class={styles.btnPrimary}
				>Copy URL</button
			>
			<a
				href="/qr"
				id="utm-qr-btn"
				class={styles.btnSecondary}
				>Generate QR →</a
			>
		</div>
	</div>
</section>
