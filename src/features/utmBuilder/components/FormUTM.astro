---
/**
 * para este formulario necesito:
 * - la url base
 * los utms:
 *  - utm_source -> plataforma de dónde viene el usuario: google, facebook, instagram, newsletter...
 *  - utm_medium -> tipo de tráfico/campaña que trae a los usuarios: cpc, email, social, banner...
 *  - utm_campaign -> nombre de la campaña que quieres hacer tracking
 *  - utm_term (opcional) -> palabra clave para la cual se está enseñando el anuncio (puedes no tener)
 *  - utm_content (opcional) -> contenido concreto en el que el usuario hace click (puedes tener uno y por ende, podría no serte útil este o tener varios en la propia página y tener que diferenciarlos con este parámetro)
*/

import styles from "./formUtm.module.css";
---

<div>
  <div class={styles.field}>
    <label class={styles.label} for="utm-url">Destination URL *</label>
    <input
      id="utm-url"
      class={styles.input}
      type="url"
      placeholder="https://yourdomain.com/landing"
      autocomplete="off"
    />
  </div>

  <div class={styles.divider}></div>

  <div class={styles.fieldRow}>
    <div class={styles.field}>
      <label class={styles.label} for="utm-source">utm_source *</label>
      <input
        id="utm-source"
        class={styles.input}
        type="text"
        placeholder="google, newsletter, instagram…"
      />
      <p class={styles.hint}>Where does the traffic come from?</p>
    </div>
    <div class={styles.field}>
      <label class={styles.label} for="utm-medium">utm_medium *</label>
      <input
        id="utm-medium"
        class={styles.input}
        type="text"
        placeholder="cpc, email, social…"
      />
      <p class={styles.hint}>What channel?</p>
    </div>
  </div>

  <div class={styles.field}>
    <label class={styles.label} for="utm-campaign">utm_campaign *</label>
    <input
      id="utm-campaign"
      class={styles.input}
      type="text"
      placeholder="black-friday-2025, product-launch…"
    />
  </div>

  <div class={styles.fieldRow3}>
    <div class={styles.field}>
      <label class={styles.label} for="utm-term">
        utm_term <span class={styles.optional}>optional</span>
      </label>
      <input id="utm-term" class={styles.input} type="text" placeholder="keyword" />
    </div>
    <div class={styles.field}>
      <label class={styles.label} for="utm-content">
        utm_content <span class={styles.optional}>optional</span>
      </label>
      <input
        id="utm-content"
        class={styles.input}
        type="text"
        placeholder="banner-top, cta-hero…"
      />
    </div>
    <div class={styles.field}>
      <label class={styles.label} for="utm-id">
        utm_id <span class={styles.optional}>optional</span>
      </label>
      <input id="utm-id" class={styles.input} type="text" placeholder="campaign-id" />
    </div>
  </div>

  <div id="utm-chips" class={styles.chipsRow}></div>
</div>
