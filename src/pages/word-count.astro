---
import Layout from "@/layouts/Layout.astro";
import MainWC from "@/features/wordCount/components/MainWC.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { TOOLS } from "@/global/site-info.ts";

const COUNTER = TOOLS.wc;
---

<Layout>
	<PagesSEO
		slot="head"
		pageTitle={COUNTER.title}
		pageDescription={COUNTER.description}
		ogType="article"
		ogImage={COUNTER.ogImage}
		ogImageAlt={COUNTER.ogImageAlt}
	/>
	<MainWC />
</Layout>
