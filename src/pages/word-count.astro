---
import Layout from "@/layouts/Layout.astro";
import MainWC from "@/features/wordCount/components/MainWC.astro";
import PagesSEO from "@/seo/PagesSEO.astro";
import JsonLdTool from "@/seo/JsonLdTool.astro";
import JsonLdFAQ from "@/seo/JsonLdFAQ.astro";

import { TOOLS } from "@/global/site-info.ts";

const COUNTER = TOOLS.wc;
---

<Layout>
	<PagesSEO
		slot="head"
		pageTitle={COUNTER.title}
		pageDescription={COUNTER.description}
		ogType="article"
		ogImage={COUNTER.ogImage}
		ogImageAlt={COUNTER.ogImageAlt}
		keywords={COUNTER.keywords}
	/>
	<JsonLdTool
		slot="head"
		name="Word Counter"
		description={COUNTER.description}
		url="/word-count"
	/>
	{COUNTER.faqs && <JsonLdFAQ slot="head" faqs={COUNTER.faqs} />}
	<MainWC />
</Layout>
